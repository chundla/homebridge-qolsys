{
  "displayName": "Homebridge Qolsys Panel",
  "name": "homebridge-qolsys",
  "version": "0.6.0",
  "description": "Homebridge plugin for Qolsys Panel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/ehylands/homebridge-qolsys.git"
  },
  "bugs": {
