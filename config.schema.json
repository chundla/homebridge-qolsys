{
  "pluginAlias": "QolsysPanel",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "Name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Qolsys Panel"
      },
      "Host":{
        "title":"Host",
        "type":"string",
        "required": true
      },
      "Port":{
        "title":"Port",
        "type": "integer",
        "required": true,
        "default" : 12345
      },
      "SecureToken":{
        "title":"Secure Token",
        "type": "string",
        "required": true,
        "default": ""
      },
      "UserPinCode":{
        "title":"User Pin Code",
        "type": "string",
        "required": true,
        "default": "0000"
      },
      "TransportMode": {
        "title": "Transport Mode",
        "type": "string",
        "default": "c4",
        "oneOf": [
          { "title": "Control4 Token (legacy/current)", "enum": ["c4"] },
          { "title": "MQTT State + Command (PKI)", "enum": ["mqtt"] }
        ],
        "required": true
      },
      "MqttUrl": {
        "title": "MQTT Broker URL",
        "type": "string",
        "description": "Broker used by qolsys-controller MQTT bridge (ex: mqtt://127.0.0.1:1883)",
        "default": "mqtt://127.0.0.1:1883",
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "MqttUsername": {
        "title": "MQTT Username",
        "type": "string",
        "description": "Optional broker username",
        "default": "",
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "MqttPassword": {
        "title": "MQTT Password",
        "type": "string",
        "description": "Optional broker password",
        "default": "",
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "MqttClientId": {
        "title": "MQTT Client ID",
        "type": "string",
        "description": "Must be unique per broker connection",
        "default": "homebridge-qolsys",
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "MqttStateTopic": {
        "title": "MQTT State Topic",
        "type": "string",
        "description": "State snapshots published by qolsys-controller",
        "default": "qolsys/state",
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "MqttCommandTopic": {
        "title": "MQTT Command Topic",
        "type": "string",
        "description": "Commands published by Homebridge",
        "default": "qolsys/command",
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "BridgeAutoStart": {
        "title": "Auto-start PKI Bridge",
        "type": "boolean",
        "default": false,
        "condition": {
          "functionBody": "return model.TransportMode === 'pki';"
        }
      },
      "BridgePythonPath": {
        "title": "PKI Bridge Python Executable",
        "type": "string",
        "default": "python3",
        "condition": {
          "functionBody": "return model.TransportMode === 'pki' && model.BridgeAutoStart === true;"
        }
      },
      "BridgeVenvPath": {
        "title": "PKI Bridge Virtualenv Path",
        "type": "string",
        "description": "Optional. Leave blank to use Homebridge storage (qolsys-bridge/.venv).",
        "default": "",
        "condition": {
          "functionBody": "return model.TransportMode === 'pki' && model.BridgeAutoStart === true;"
        }
      },
      "BridgeConfigPath": {
        "title": "PKI Bridge Config Path",
        "type": "string",
        "description": "Optional. Leave blank to use Homebridge storage (qolsys-bridge/config.json).",
        "default": "",
        "condition": {
          "functionBody": "return model.TransportMode === 'pki' && model.BridgeAutoStart === true;"
        }
      },
      "BridgePanelIp": {
        "title": "PKI Panel IP",
        "type": "string",
        "default": "",
        "condition": {
          "functionBody": "return model.TransportMode === 'pki' && model.BridgeAutoStart === true;"
        }
      },
      "BridgePanelMac": {
        "title": "PKI Panel MAC",
        "type": "string",
        "default": "",
        "condition": {
          "functionBody": "return model.TransportMode === 'pki' && model.BridgeAutoStart === true;"
        }
      },
      "BridgePluginIp": {
        "title": "PKI Bridge Host IP",
        "type": "string",
        "default": "",
        "condition": {
          "functionBody": "return model.TransportMode === 'pki' && model.BridgeAutoStart === true;"
        }
      },
      "BridgeForceVenvRecreate": {
        "title": "PKI Bridge Force Venv Recreate",
        "type": "boolean",
        "default": false,
        "condition": {
          "functionBody": "return model.TransportMode === 'pki' && model.BridgeAutoStart === true;"
        }
      },
      "ForceArm":{
        "title":"Force Arm",
        "type": "boolean",
        "required": true,
        "default": true,
        "condition": {
          "functionBody": "return model.ShowSecurityPanel === true;"
        }
      },
      "AwayExitDelay":{
        "title":"Arm Away Exit Delay",
        "type": "integer",
        "required": true,
        "default": 120,
        "condition": {
          "functionBody": "return model.ShowSecurityPanel === true;"
        }
      },
      "HomeExitDelay":{
        "title":"Arm Stay Exit Delay",
        "type": "integer",
        "required": true,
        "default": 120,
        "condition": {
          "functionBody": "return model.ShowSecurityPanel === true;"
        }
      },
      "ShowSecurityPanel":{
        "type": "boolean",
        "title": "Show Homekit Security System Accessories",
        "default": true
      },
      "ShowMotion":{
        "type": "boolean",
        "title": "Show Homekit Motion and Occupancy Sensors",
        "default": true
      },
      "ShowContact":{
        "type": "boolean",
        "title": "Show Contact Sensors",
        "default": true
      },
      "ShowCO":{
        "type": "boolean",
        "title": "Show CO Sensors",
        "default": true
      },
      "ShowSmoke":{
        "type": "boolean",
        "title": "Show Smoke Sensors",
        "default": true
      },
      "ShowHeat":{
        "type": "boolean",
        "title": "Show Heat Sensors",
        "default": true
      },
      "ShowLeak":{
        "type": "boolean",
        "title": "Show Leak Sensors",
        "default": true
      },
      "ShowTilt":{
        "type": "boolean",
        "title": "Show Tilt Sensors",
        "default": true
      },
      "ShowGlassBreak":{
        "type": "boolean",
        "title": "Show Glass Break Sensors",
        "default": false
      },
      "ShowDoorbell":{
        "type": "boolean",
        "title": "Show Doorbell sensor",
        "default": true
      },
      "ShowFreeze":{
        "type": "boolean",
        "title": "Show Freeze sensor",
        "default": true
      },
      "LogPartition":{
        "type": "boolean",
        "title": "Show Partitions notifications",
        "default": true
      },
      "LogZone":{
        "type": "boolean",
        "title": "Show Zones notifications",
        "default": false
      },
      "LogDebug":{
        "type": "boolean",
        "title": "Show Qolsys panel debug information",
        "default": false
      },
      "ShowAutomationLocks": {
        "type": "boolean",
        "title": "Show Automation Locks",
        "default": true,
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "ShowAutomationLights": {
        "type": "boolean",
        "title": "Show Automation Lights",
        "default": true,
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "ShowAutomationThermostats": {
        "type": "boolean",
        "title": "Show Automation Thermostats",
        "default": true,
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "ShowAutomationCovers": {
        "type": "boolean",
        "title": "Show Automation Covers",
        "default": true,
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "ShowAutomationSirens": {
        "type": "boolean",
        "title": "Show Automation Sirens",
        "default": true,
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "ShowAutomationValves": {
        "type": "boolean",
        "title": "Show Automation Valves",
        "default": true,
        "condition": {
          "functionBody": "return model.TransportMode === 'mqtt';"
        }
      },
      "MotionSensorMode": {
        "title": "Homekit Sensor Mode",
        "type": "string",
        "default": "Motion",
        "oneOf": [
          { "title": "Show as Motion Sensors", "enum": ["Motion"] },
          { "title": "Show as Occupancy Sensors", "enum": ["Occupancy"] },
          { "title": "Show as Motion and Occupancy Sensors", "enum": ["MotionOccupancy"] }
        ],
        "condition": {
          "functionBody": "return model.ShowMotion === true;"
        },
        "required": true
      },
      "MotionDelay":{
        "type": "integer",
        "title": "Motion sensor trigger duration (min)",
        "minimum": 0,
        "maximum": 60,
        "default": 6,
        "condition": {
          "functionBody": "return model.ShowMotion === true && (model.MotionSensorMode === 'Motion' || model.MotionSensorMode === 'MotionOccupancy');"
        },
        "required": true
      },
      "OccupancyDelay":{
        "type": "integer",
        "title": "Occupancy sensor trigger duration (min)",
        "minimum": 5,
        "maximum": 1440,
        "default": 30,
        "condition": {
          "functionBody": "return model.ShowMotion === true && (model.MotionSensorMode === 'Occupancy' || model.MotionSensorMode === 'MotionOccupancy');"
        },
        "required": true

      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "expandable": false,
      "items":[ 
        {
          "type": "help",
          "helpvalue": "<em class='primary-text'> Please read: </em> <a href='https://github.com/EHylands/homebridge-qolsys'> homebridge-qolsys</a>"
        },{
          "type": "flex",
          "flex-flow": "row wrap",
          "items": [
            "Host",
            "Port"
          ]
        },{
          "type": "flex",
          "flex-flow": "row wrap",
          "items": [
            "SecureToken",
            "UserPinCode"
          ]
        },
        {
          "title": "Transport Options",
          "type": "fieldset",
          "expandable": true,
          "expanded": true,
          "items": [
            "TransportMode",
            "MqttUrl",
            "MqttUsername",
            "MqttPassword",
            "MqttClientId",
            "MqttStateTopic",
            "MqttCommandTopic"
          ]
        },
        {
          "title": "Security Panel Options",
          "type": "fieldset",
          "expandable": true,
          "expanded": true,
          "items": [
            "ShowSecurityPanel",
            "ForceArm",
            "AwayExitDelay",
            "HomeExitDelay"
          ]
        },
        {
          "title": "Motion Sensors Options",
          "type": "fieldset",
          "expandable": true,
          "expanded": true,
          "items": [
            "ShowMotion",
            "MotionSensorMode",
            "MotionDelay",
            "OccupancyDelay"
          ]
        },
        {
          "title": "Other Sensors Options",
          "type": "fieldset",
          "expandable": true,
          "expanded": true,
          "items": [
            "ShowContact",
            "ShowSmoke",
            "ShowHeat",
            "ShowCO",
            "ShowLeak",
            "ShowTilt",
            "ShowGlassBreak",
            "ShowDoorbell",
            "ShowFreeze"
          ]
        },
        {
          "title": "Log File Options",
          "type": "fieldset",
          "expandable": true,
          "expanded": true,
          "items": [
            "LogPartition",
            "LogZone",
            "LogDebug"
          ]
        },
        {
          "title": "Experimental Options",
          "type": "fieldset",
          "expandable": true,
          "expanded": true,
          "items": [
            "ShowAutomationLocks",
            "ShowAutomationLights",
            "ShowAutomationThermostats",
            "ShowAutomationCovers",
            "ShowAutomationSirens",
            "ShowAutomationValves"
          ]
        }]
    }
  ]
}



           